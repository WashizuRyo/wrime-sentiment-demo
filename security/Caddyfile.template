{
    admin off
    auto_https off
}
http://:8080 {
    redir https://localhost:8443{uri} 308
}
:8443, :8445 {
    tls /certs/server.crt /certs/server.key
    encode gzip zstd
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer
    header Content-Security-Policy "default-src 'self'; connect-src 'self' https://localhost:9443; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"
    @signin {
        path /auth
        method POST
        header X-Amz-Target AWSCognitoIdentityProviderService.InitiateAuth
    }
    handle @signin {
        rewrite * /
        header Cache-Control no-store
        reverse_proxy floci:4566
    }
    handle /auth {
        respond 404
    }
    handle /config.json {
        root * /srv
        header Cache-Control no-store
        file_server
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        header Cache-Control no-cache
        try_files {path} /index.html
        file_server
    }
}
:9443 {
    tls /certs/server.crt /certs/server.key
    header Cache-Control no-store
    header X-Content-Type-Options nosniff
    rewrite * /execute-api/__API_ID__/$default{uri}
    reverse_proxy floci:4566
}
